load(":defs.bzl", "download")

# What a test declares about the download comes from the config, so that one fixture serves
# every combination of checksums and sizes.
download(
    name = "download",
    url = read_config("test", "url"),
    sha1 = read_config("test", "sha1"),
    sha256 = read_config("test", "sha256"),
    sha512 = read_config("test", "sha512"),
    size_bytes = int(read_config("test", "size_bytes")) if read_config("test", "size_bytes") != None else None,
)
